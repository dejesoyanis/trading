# Local development only.
# Copy this file to .env. Do not put production or broker credentials in either file.
# .env is gitignored. Live trading is not supported.

# Deployment environment. This is not a trading mode and does not enable trading.
# Valid values: local, test, production.
# paper and live are rejected.
APP_ENV=local

# IP address and port. The default listens on loopback only.
HTTP_BIND_ADDRESS=127.0.0.1:8080

# error, warn, info, debug, or trace.
LOG_LEVEL=info

# text or json.
LOG_FORMAT=text

# Local Docker Compose database. These values are development defaults.
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading
POSTGRES_PORT=5432

# Consumed by trading-api and by `trading-api migrate`. Keep it aligned with the
# POSTGRES_* values above. The API does not migrate on startup.
# Apply infrastructure migrations explicitly, then start the API:
#   cargo run -p trading-api -- migrate
# GET /health/ready stays unavailable until that command succeeds.
DATABASE_URL=postgres://trading:trading@127.0.0.1:5432/trading
