  "questions": [
    {
      "id": "BROKERQ-01",
      "decision_id": "ARCH-DEC-35",
      "choice": "B",
      "wording": "Vorhandene Broker-/Konto-/Umgebungs-/Session-/Aliasfelder, Client und Adapter-Epoch sowie Evidence-ID nur soweit tatsächlich geliefert als mögliche zukünftige Evidenzkomponenten erfassen. Fehlend bleibt fehlend. Feldgleichheit ist weder Merge noch Uniqueness; kein Schema.",
      "source_anchor": "## BROKERQ-01 — Identity tuple for a future record",
      "ratification_date": "2026-11-15",
      "scope_code": "SUPPLIED_SCOPE_NO_MERGE_NO_SCHEMA",
      "depends_on": ["ARCH-DEC-13", "ARCH-DEC-26"],
      "policy_only": true,
      "implemented": false,
      "verification": "NOT_VERIFIED"
    },
    {
      "id": "BROKERQ-02",
      "decision_id": "ARCH-DEC-36",
      "choice": "B",
      "wording": "Zukünftige Kandidatenmenge `A(e)` und Unsicherheitslabel erlauben; selbst `|A(e)|=1` ist `SINGLE_CANDIDATE_NOT_AUTHORIZATION`; 0/mehrere/Widerspruch ebenso nicht autorisierend. Keine automatische Zuordnung mit wirtschaftlicher Wirkung.",
      "source_anchor": "## BROKERQ-02 — Ambiguity and candidate sets",
      "ratification_date": "2026-11-15",
      "scope_code": "CANDIDATE_SET_NOT_AUTHORIZATION",
      "depends_on": ["ARCH-DEC-13", "ARCH-DEC-26"],
      "policy_only": true,
      "implemented": false,
      "verification": "NOT_VERIFIED"
    },
    {
      "id": "BROKERQ-03",
      "decision_id": "ARCH-DEC-37",
      "choice": "B",
      "wording": "Beobachtung auch ohne `permId` behalten; fehlend/null/zero nicht stillschweigend gleichsetzen. Spätere `permId` als neue Evidenz, kein Overwrite. Null-/Zero-Semantik bleibt extern ungeprüft.",
      "source_anchor": "## BROKERQ-03 — Missing permId",
      "ratification_date": "2026-11-15",
      "scope_code": "RETAIN_ABSENT_PERMID_NO_ZERO_EQUATION",
      "depends_on": ["ARCH-DEC-12", "ARCH-DEC-13"],
      "policy_only": true,
      "implemented": false,
      "verification": "NOT_VERIFIED"
    },
    {
      "id": "BROKERQ-04",
      "decision_id": "ARCH-DEC-38",
      "choice": "B",
      "wording": "Identischer Rohpayload bei Wiederholung idempotent als erneut gesehen; abweichender Payload unter scheinbar gleichem Schlüssel `CONTRADICTION`, beide Originale erhalten. Keine zweite Ausführung/Buchung, keine Bytes löschen.",
      "source_anchor": "## BROKERQ-04 — Duplicate executions",
      "ratification_date": "2026-11-15",
      "scope_code": "IDENTICAL_REPLAY_OR_CONTRADICTION_KEEP_BOTH",
      "depends_on": ["ARCH-DEC-16", "ARCH-DEC-13"],
      "policy_only": true,
      "implemented": false,
      "verification": "NOT_VERIFIED"
    },
    {
      "id": "BROKERQ-05",
      "decision_id": "ARCH-DEC-39",
      "choice": "B",
      "wording": "Correction/Bust append-only mit Original-Evidenz verknüpfen, nur wenn die neue Evidenz selbst einen Bezug liefert. Kein erfundener Link, keine Reversal-Buchung, kein Release, keine Closure-Änderung.",
      "source_anchor": "## BROKERQ-05 — Correction and bust chain",
      "ratification_date": "2026-11-15",
      "scope_code": "APPEND_LINK_ONLY_IF_EVIDENCE_NAMES_IT",
      "depends_on": ["ARCH-DEC-09", "ARCH-DEC-26"],
      "policy_only": true,
      "implemented": false,
      "verification": "NOT_VERIFIED"
    },
    {
      "id": "BROKERQ-06",
      "decision_id": "ARCH-DEC-40",
      "choice": "B",
      "wording": "Angefragten Account-/Client-/Session-/Dataset-/Zeitfenster-Scope soweit vorhanden dokumentieren; Coverage bleibt `UNKNOWN`, nicht global, keine `COMPLETE`-Behauptung.",
      "source_anchor": "## BROKERQ-06 — Snapshot scope",
      "ratification_date": "2026-11-15",
      "scope_code": "REQUESTED_SCOPE_COVERAGE_UNKNOWN",
      "depends_on": ["ARCH-DEC-14", "ARCH-DEC-17"],
      "policy_only": true,
      "implemented": false,
      "verification": "NOT_VERIFIED"
    },
    {
      "id": "BROKERQ-07",
      "decision_id": "ARCH-DEC-41",
      "choice": "A",
      "wording": "Keine Completeness-Tokens speichern. Kein `COMPLETE`-Marker und kein externer Token-Platzhalter als Ratifikation; leere Antwort ist kein Nicht-Existenz-/Finalitäts-/Release-Beweis.",
      "source_anchor": "## BROKERQ-07 — Completeness proof",
      "ratification_date": "2026-11-15",
      "scope_code": "NO_COMPLETENESS_TOKEN",
      "depends_on": ["ARCH-DEC-14", "ARCH-DEC-17", "ARCH-DEC-28", "ARCH-DEC-29"],
      "policy_only": true,
      "implemented": false,
      "verification": "NOT_VERIFIED"
    },
    {
      "id": "BROKERQ-08",
      "decision_id": "ARCH-DEC-42",
      "choice": "B",
      "wording": "Nur tatsächlich lokal beobachtete Capture-Gaps (z.B. kurze Seite, fehlendes Antwortende, Drop) markieren; kein erfundener IBKR-Sequenzzähler, keine Interpolation, Scope bleibt unvollständig, keine Folgeaktion.",
      "source_anchor": "## BROKERQ-08 — Gap detection",
      "ratification_date": "2026-11-15",
      "scope_code": "LOCAL_CAPTURE_GAP_NOT_IBKR_SEQUENCE",
      "depends_on": ["ARCH-DEC-14"],
      "policy_only": true,
      "implemented": false,
      "verification": "NOT_VERIFIED"
    },
    {
      "id": "BROKERQ-09",
      "decision_id": "ARCH-DEC-43",
      "choice": "B",
      "wording": "Reconnect erzeugt neuen Session-Kontext; alte Evidenz behalten, IDs nicht ohne nachgewiesene Bindung über Session-Grenzen übernehmen. Reconnect ist kein Send-Negativbeweis.",
      "source_anchor": "## BROKERQ-09 — Reconnect",
      "ratification_date": "2026-11-15",
      "scope_code": "NEW_SESSION_NO_CROSS_SESSION_ID_CARRY",
      "depends_on": ["ARCH-DEC-03", "ARCH-DEC-11"],
      "policy_only": true,
      "implemented": false,
      "verification": "NOT_VERIFIED"
    },
    {
      "id": "BROKERQ-10",
      "decision_id": "ARCH-DEC-44",
      "choice": "B",
      "wording": "CR-B01-Crash-/Dispatch-Fenster als Labels dokumentieren. Nach `DISPATCH_STARTED` möglicherweise gesendet; kein Fenster dieses Pakets erlaubt Resend, Cancel, Release oder Dispatch.",
      "source_anchor": "## BROKERQ-10 — Unknown send",
      "ratification_date": "2026-11-15",
      "scope_code": "WINDOW_LABELS_NO_RESEND",
      "depends_on": ["ARCH-DEC-03", "ARCH-DEC-11", "ARCH-DEC-34"],
      "policy_only": true,
      "implemented": false,
      "verification": "NOT_VERIFIED"
    },
    {
      "id": "BROKERQ-11",
      "decision_id": "ARCH-DEC-45",
      "choice": "B",
      "wording": "Lokale Fence-Fakten (Epoch, Lease-Deadline, Authority-Label) von Broker-Akzeptanz strikt trennen; Successor blockiert solange früherer Writer noch senden könnte oder Sendestatus unbekannt ist. Lease-Ablauf/neuere Epoch beweist kein externes Fencing. Keine Implementierung oder TTL.",
      "source_anchor": "## BROKERQ-11 — Epoch fencing and broker acceptance",
      "ratification_date": "2026-11-15",
      "scope_code": "LOCAL_FENCE_NOT_BROKER_ACCEPTANCE",
      "depends_on": ["ARCH-DEC-03"],
      "policy_only": true,
      "implemented": false,
      "verification": "NOT_VERIFIED"
    },
    {
      "id": "BROKERQ-12",
      "decision_id": "ARCH-DEC-46",
      "choice": "B",
      "wording": "Nur nicht-autorisierenden Eskalationsmarker für spätere menschliche Prüfung vorsehen; keine Rolle, kein Post-/Release-/Dispatch-/Reset-Recht. Fehlende erforderliche zweite Person bedeutet Deny, nicht simulierte Zustimmung.",
      "source_anchor": "## BROKERQ-12 — Manual escalation",
      "ratification_date": "2026-11-15",
      "scope_code": "ESCALATION_MARKER_NO_ROLE",
      "depends_on": ["ARCH-DEC-13", "ARCH-DEC-16", "ARCH-DEC-33"],
      "policy_only": true,
      "implemented": false,
      "verification": "NOT_VERIFIED"
    },
    {
      "id": "BROKERQ-13",
      "decision_id": "ARCH-DEC-47",
      "choice": "B",
      "wording": "Broker-Rohbeobachtung und lokale Attempt-Fakten bei Widerspruch beide erhalten; Vergleich als Inferenz kennzeichnen. Keine Seite gewinnt pauschal, kein wirtschaftlicher Schluss, kein Cancel.",
      "source_anchor": "## BROKERQ-13 — Evidence authority",
      "ratification_date": "2026-11-15",
      "scope_code": "RETAIN_BOTH_NO_WINNER",
      "depends_on": ["ARCH-DEC-13", "ARCH-DEC-17"],
      "policy_only": true,
      "implemented": false,
      "verification": "NOT_VERIFIED"
    },
    {
      "id": "BROKERQ-14",
      "decision_id": "ARCH-DEC-48",
      "choice": "B",
      "wording": "Für spätere Verifikation tatsächlich beschaffte offizielle Unterlagen, reproduzierbare positive/negative Fälle, Umgebung, Brokerprodukt/API-Version, Zeitstempel und Rohpayloads verlangen. Heute alles `NOT_EXECUTED`/`EXTERNAL_EVIDENCE_PENDING`; Dokumentations-/Unit-Tests sind keine Broker-Evidenz.",
      "source_anchor": "## BROKERQ-14 — Future verification bar",
      "ratification_date": "2026-11-15",
      "scope_code": "EXTERNAL_BAR_NOT_EXECUTED",
      "depends_on": ["ARCH-DEC-04"],
      "policy_only": true,
      "implemented": false,
      "verification": "NOT_VERIFIED"
    }
  ],
